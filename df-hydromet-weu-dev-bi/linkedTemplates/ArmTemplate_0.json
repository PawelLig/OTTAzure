						},
						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": "delete from temp_DimCustomer;\n\ninsert into temp_DimCustomer\n(\n\tCustomerNumber\n\t,CustomerName\n\t,Country\n\t,CountryCode\n\t,CustomerType\n\t,CustomerStatus\n\t,SFCustomerType\n\t,Site\n\t,cus_h_key\n)\nSELECT \n\tcust_num\n\t,name\n\t,country\n\t,'CA'\n\t,cust_type\n\t,stat\n\t,uf_sf_customer_type\n\t,site_ref\n\t,HASHBYTES('SHA1', concat(cust_num,cust_type,site_ref)) cus_h_key\nFROM stg.csi_Customer;"
