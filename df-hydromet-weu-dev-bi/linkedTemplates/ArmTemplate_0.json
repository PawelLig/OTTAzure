						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": "TRUNCATE TABLE stg.csi_Vendor;\n\nWITH ADDR AS (\n    SELECT \n        ROW_NUMBER() OVER (PARTITION BY site_ref, vend_num ORDER BY VariationNumber DESC) AS rn,\n        vend_num,\n        Name,\n        CAST(RecordDate AS DATE) AS RecordDate,\n        site_ref,\n        country\n    FROM raw.csi_vendaddr_mst\n),\nVEND AS (\n    SELECT \n        ROW_NUMBER() OVER (PARTITION BY site_ref, vend_num ORDER BY RecordDate DESC) AS rn,\n        vend_num,\n        vend_type,\n        stat,\n        site_ref\n    FROM raw.csi_vendor_mst\n)\n\nINSERT INTO stg.csi_Vendor (\n    vend_num,\n    vend_name,\n    country,\n    vend_type,\n    stat,\n    site_ref\n)\nSELECT \n    ADDR.vend_num,\n    ADDR.Name,\n    ADDR.country,\n    VEND.vend_type,\n    VEND.stat,\n    ADDR.site_ref\nFROM ADDR\nINNER JOIN VEND \n    ON ADDR.site_ref = VEND.site_ref \n    AND ADDR.vend_num = VEND.vend_num\nWHERE ADDR.rn = 1 AND VEND.rn = 1;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "load temp_DimCustomer",
