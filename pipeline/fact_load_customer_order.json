{
	"name": "fact_load_customer_order",
	"properties": {
		"activities": [
			{
				"name": "stage customer order",
				"type": "Script",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_ott_sql_dev_bi",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "truncate table stg.csi_customer_orders;\n\nWith OrderHeader as\n\t(SELECT \n\t\ttrim(oh.[co_num]) as co_num -- Order (Number)\n\t\t--,CAST(oh.[order_date] as datetime) AT TIME ZONE 'Central European Standard Time' as order_date2 -- Order Date\n\t\t,dateadd(HOUR,2, CAST(oh.[order_date] as datetime)) as order_date\n\t\t,CAST(oh.CreateDate as date) as CreateDate\n\t\t,oh.[cust_num] -- Customer\n\t\t,oh.[bill_to_country]\n\t\t,oh.bill_to_state\n\t\t,oh.bill_to_zip\n\t\t,oh.ship_to_country\n\t\t,oh.ship_to_state\n\t\t,oh.ship_to_zip\n\t\t,oh.[site_ref]\n\t\t,oh.[curr_code] -- Currency\n\t\t,oh.[exch_rate] -- Rate'\n\t\t,oh.[price] EstTotalPrice-- Price\n\t\t,oh.sales_tax + oh.sales_tax_2 + oh.sales_tax_t as Tax\n\t\t,oh.freight + oh.freight_t as Freight\n\t\t,oh.[slsman] -- Salesperson - External\n\t\t,oh.taken_by -- Taken by - internal\n\t\t,oh.[stat] OrderStatus-- order Status - Planned / Ordered / Complete / Stopped / History\n\t\t,oh.Uf_SF_Application [Application]\n\t\t,oh.invoiced\n\tFROM [raw].[csi_co_mst] oh\n\tWhere \n\toh.type = 'R')\n\t,\n\tOrderDetail as\n\t(\n\t\tSELECT \n\t\ttrim(od.[co_num]) as co_num -- Order (Number)\n\t\t,od.co_line\n\t\t,od.item\n\t\t,od.price_conv\n\t\t,od.qty_ordered_conv\n\t\t,od.disc\n\t\t,od.stat ItemStatus\n\t\t,od.DLDeleteIndicator\n\t\t,CAST(od.RecordDate as date) As RecordDate\n\t\t,dateadd(HOUR,2, CAST(od.due_date as datetime)) As due_date\n\t\t,dateadd(HOUR,2, CAST(od.promise_date as datetime)) As promise_date\n\t\t,CAST(od.CreateDate as date) As CreateDate\n\t\t,od.site_ref\n\t\t,od.stat As OrderLineStatus\n\t\tFROM [raw].[csi_coitem_mst] od\n\t)\n\tINSERT INTO stg.csi_customer_orders\n        (co_num\n\t\t,order_date\n\t\t,site_ref\n\t\t,bill_to_country\n\t\t,bill_to_state\n\t\t,bill_to_zip\n\t\t,ship_to_country\n\t\t,ship_to_state\n\t\t,ship_to_zip\n\t\t,OrderStatus\n\t\t,Tax\n\t\t,Freight\n\t\t,cust_num\n\t\t,Application\n\t\t,curr_code\n\t\t,slsman\n\t\t,taken_by\n\t\t,OrderCreateDate \n\t\t,co_line\n\t\t,item\n\t\t,price_conv\n\t\t,qty_ordered_conv\n\t\t,disc\n\t\t,OrderLineStatus\n\t\t,DLDeleteIndicator\n\t\t,RecordDate\n\t\t,due_date\n\t\t,promise_date\n\t\t,OrderlineCreateDate\n\t\t,invoiced)\n\tSelect \n\t\th.co_num\n\t\t,h.order_date\n\t\t,h.site_ref\n\t\t,h.bill_to_country\n\t\t,h.bill_to_state\n\t\t,h.bill_to_zip\n\t\t,h.ship_to_country\n\t\t,h.ship_to_state\n\t\t,h.ship_to_zip\n\t\t,h.OrderStatus\n\t\t,h.Tax\n\t\t,h.Freight\n\t\t,h.cust_num\n\t\t,h.Application\n\t\t,h.curr_code\n\t\t,h.slsman\n\t\t,h.taken_by\n\t\t,h.CreateDate As OrderCreateDate\n\t\t,d.co_line\n\t\t,d.item\n\t\t,d.price_conv\n\t\t,d.qty_ordered_conv\n\t\t,d.disc\n\t\t,d.ItemStatus\n\t\t,d.DLDeleteIndicator\n\t\t,d.RecordDate\n\t\t,d.due_date\n\t\t,d.promise_date\n\t\t,d.CreateDate As OrderlineCreateDate\n\t\t,h.invoiced\n\tFrom OrderHeader h\n\tinner join OrderDetail d on \n\t\th.co_num = d.co_num and\n\t\th.site_ref = d.site_ref\n\t--where h.rn = 1 and d.rn = 1;"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
