					"source": {
						"type": "SqlMISource",
						"sqlReaderQuery": "SELECT  \r\n\ts.SourceSystemID\r\n\t,co_num\r\n\t,o.order_date\r\n\t,o.site_ref\r\n\t,o.bill_to_country\r\n\t,o.bill_to_state\r\n\t,o.bill_to_zip\r\n\t,o.ship_to_country\r\n\t,o.ship_to_state\r\n\t,o.ship_to_zip\r\n\t,o.OrderStatus\r\n\t,o.Tax\r\n\t,o.Freight\r\n\t,o.cust_num\r\n\t,c.CustomerID\r\n\t,o.Application\r\n\t,o.curr_code\r\n\t,o.slsman\r\n\t,o.taken_by\r\n\t,o.co_line\r\n\t,o.item\r\n\t,i.ItemID\r\n\t,o.price_conv\r\n\t,o.disc\r\n\t,o.qty_ordered_conv\r\n\t,o.OrderLineStatus\r\n\t,o.DLDeleteIndicator\r\n\t,o.due_date\r\n\t,o.promise_date\r\n\t,o.OrderCreateDate\r\n\t,o.OrderlineCreateDate\r\n\t,o.RecordDate\r\n\t,o.invoiced\r\n\t,case o.OrderLineStatus\r\n\twhen 'C' then 1\r\n\twhen 'F' then 1\r\n\telse 0\r\n\tend as Complete\r\n\t,(o.qty_ordered_conv * o.price_conv) * (1 - (disc/100)) As Amount\r\n\t,'Base' as OrderType\r\n\t,isnull(v.ApplicationCode,0) as ApplicationCode\r\n\t,bc.iso_country_code as BillToCountryCode\r\n\t,sc.iso_country_code as ShipToCountryCode\r\n\t\r\nFROM stg.csi_customer_orders o\r\nleft join edw.Dim_SourceSystem s on o.site_ref = s.Site\r\nleft join edw.Dim_Customer c on o.cust_num = c.CustomerNumber and o.site_ref = c.Site\r\nleft join edw.Dim_Item i on o.item = i.Item and o.site_ref = i.Site\r\nleft join edw.Dim_Vertical v on o.Application = v.ApplicationName\r\nleft join stg.csi_Country bc on o.bill_to_country = bc.Country\r\nleft join stg.csi_Country sc on o.ship_to_country = sc.Country",
