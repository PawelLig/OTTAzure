				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlMISource",
						"sqlReaderQuery": "with srinv as\r\n(\r\n\tSELECT \r\n\t\tsite_ref\r\n\t\t,inv.cust_num\r\n\t\t,cast(inv.inv_date as date) as inv_date\r\n\t\t,trim(inv.inv_num) inv_num\r\n\t\t,trim(co_num) co_num\r\n\t\t--,inv.item \r\n\t\t--,inv.qty_invoiced\r\n\t\t,inv.curr_code\r\n\t\t,'Service' as OrderType\r\n\t\t--,cast(inv.price as decimal(18,2)) as price\t-- inv.price\r\n\t\t--,cast(inv.disc as decimal(18,2)) as disc\t\t-- inv.disc\r\n\t\t--,inv.RecordDate\r\n\t\t--,inv.LineCreateDate\r\n\t\t,GETDATE() as ProcessDate\r\n\t\t,freight\r\n\t\t,bill_type\r\n\t\t,total_price\r\n\tFROM stg.csi_invoices inv\r\n\twhere \r\n\ttrim(bill_type) in ('S','M','P','N')\r\n)\r\n,srline as\r\n(\r\n\tselect\r\n\t\tsite_ref\r\n\t\t,sro_num\r\n\t\t,line\r\n\t\t,inv_line\r\n\t\t,item\r\n\t\t,matl_qty\r\n\t\t,case trans_type\r\n\t\t\twhen 'R' then extprice * -1\r\n\t\t\telse extprice\r\n\t\t end as extprice\r\n\t\t,disc\r\n\t\t,inv_num\r\n\t\t--,Amount\r\n\t\t,posted\r\n\t\t,type\r\n\t\t,trans_type\r\n\t\t,sro_line\r\n\t\t,crd\r\n\t\t,due_date\r\n\t\t,DLDeleteIndicator\r\n\tfrom stg.csi_service_orders\r\n)\r\nSelect \r\n\ts.SourceSystemID\r\n\t,h.site_ref\r\n\t,h.cust_num\r\n\t,c.CustomerID\r\n\t,h.inv_num\r\n\t,l.inv_line\r\n\t,h.inv_date\r\n\t,h.freight\r\n\t,h.total_price\r\n\t,l.sro_num\r\n\t,l.line\r\n\t,l.item\r\n\t,i.ItemID\r\n\t,l.matl_qty\r\n\t,h.curr_code\r\n\t,h.OrderType\r\n\t,l.extprice\r\n\t,l.disc\r\n\t--,l.Amount\r\n\t,l.posted\r\n\t,l.type\r\n\t,l.trans_type\r\n\t,l.sro_line\r\n\t,l.crd\r\n\t,l.due_date\r\n\t,l.DLDeleteIndicator\r\n\t,h.bill_type\r\n\t--,h.RecordDate\r\n\t--,h.LineCreateDate\r\n\t--,h.ProcessDate\r\nfrom srinv h\r\ninner join srline l on \r\n\th.site_ref = l.site_ref and\r\n\th.co_num = l.sro_num and\r\n\th.inv_num = l.inv_num\r\ninner join edw.Dim_SourceSystem s on\r\n\th.site_ref = s.Site\r\nleft join edw.Dim_Item i on\r\n\tl.item = i.Item and l.site_ref = i.Site\r\nleft join edw.Dim_Customer c on \r\n\th.cust_num = c.CustomerNumber and h.site_ref = c.Site\r\n",
						"partitionOption": "None"
					},
