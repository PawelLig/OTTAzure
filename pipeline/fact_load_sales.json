						"sqlReaderQuery": "SELECT \r\n\ts.SourceSystemID\r\n\t,GETDATE() as ProcessDate\r\n\t,inv.cust_num\r\n\t,c.CustomerID\r\n\t,inv.site_ref\r\n\t,inv.inv_date\r\n\t,trim(inv.inv_num) inv_num\r\n\t,inv.co_num\r\n\t,inv.co_line\r\n\t,inv.item \r\n\t,i.ItemID \r\n\t,inv.qty_invoiced\r\n\t,inv.price\r\n\t,inv.RecordDate\r\n\t,inv.LineCreateDate\r\n\t,inv.curr_code\r\n\t,inv.disc\r\n\t,'Base' as OrderType\r\n\t,cast(inv.price as decimal(18,2)) as DocExtPrice\t-- inv.price\r\n\t,cast(inv.disc as decimal(18,2)) as DocDiscount\t\t-- inv.disc\r\n\t,cast(inv.price as decimal(18,2)) as ExtPrice\t\t-- inv.price\r\n\t,cast(inv.disc as decimal(18,2)) as Discount\t\t-- inv.disc\r\n\t,(inv.qty_invoiced * inv.price)  As Amount\r\n\t,isnull(DLDeleteIndicator,0) as VoidLine \r\n\t,inv.bill_type\r\n\t,inv.total_price\r\nFROM stg.csi_invoices inv\r\nLeft Join edw.Dim_Customer c on inv.cust_num = c.CustomerNumber and inv.site_ref = c.Site\r\nLeft Join edw.Dim_Item i on inv.item = i.item  and inv.site_ref = i.Site\r\nleft join edw.Dim_SourceSystem s on inv.site_ref = s.Site\r\nwhere --inv.co_num in (select distinct OrderNumber from fact_Booking where OrderType = 'Base')\r\n----and \r\ninv.bill_type in ('N','R','M','P')",
