				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "truncate table stg.csi_invoices;\r\n\r\nWith invhdr As\r\n\t(SELECT  \r\n\t\ttrim(inv_num) inv_num -- Invoice Number\r\n\t\t,site_ref -- Site reference\r\n\t\t,trim(co_num) co_num -- Customer Order \r\n\t\t,trim(cust_num) cust_num -- Customer Number  \r\n\t\t,dateadd(HOUR,2, CAST(inv_date as datetime)) inv_date  -- Invoice Date\r\n\t\t,cust_po\r\n\t\t,ec_code\r\n\t\t,freight\r\n\t\t,curr_code\r\n\t\t,price\r\n\t\t,CAST(RecordDate as date) RecordDate\r\n\t\t,CAST(CreateDate as date) CreateDate\r\n\t\t,shipment_id\r\n\t\t,slsman\r\n\t\t,state\r\n\t\t,bill_type\r\n\t\t,DLDeleteIndicator\r\n\tFROM raw.csi_inv_hdr_mst )\r\n\t,invdtl AS\r\n\t(Select\r\n\t\ttrim(inv_num) inv_num -- Invoice Number\r\n\t\t,site_ref -- Site reference\r\n\t\t,trim(co_num) co_num -- Customer Order \r\n\t\t,co_line\r\n\t\t,CAST(RecordDate as date) RecordDate\r\n\t\t,CAST(CreateDate as date) CreateDate\r\n\t\t,cost\r\n\t\t,disc\r\n\t\t,item\r\n\t\t,price\r\n\t\t,qty_invoiced\r\n\t\t,DLDeleteIndicator\r\n\tFROM raw.csi_inv_item_mst\r\n\t)\r\ninsert into stg.csi_invoices\r\n(\tsite_ref\r\n\t,cust_num\r\n\t,inv_date\r\n\t,inv_num\r\n\t,co_num\r\n\t,curr_code\r\n\t,total_price\r\n\t,cust_po\r\n\t,ec_code\r\n\t,shipment_id\r\n\t,slsman\r\n\t,bill_type\r\n\t,co_line\r\n\t,item\r\n\t,qty_invoiced\r\n\t,price\r\n\t,RecordDate\r\n\t,disc\r\n\t,freight\r\n\t,InvCreateDate\r\n\t,LineCreateDate\r\n\t,DLDeleteIndicator)\r\nSelect --distinct\r\n\th.site_ref\r\n\t,h.cust_num\r\n\t,h.inv_date\r\n\t,h.inv_num\r\n\t,h.co_num\r\n\t,h.curr_code\r\n\t,h.price as total_price\r\n\t,h.cust_po\r\n\t,h.ec_code\r\n\t,h.shipment_id\r\n\t,h.slsman\r\n\t,h.bill_type\r\n\t,d.co_line\r\n\t,d.item\r\n\t,d.qty_invoiced\r\n\t,d.price\r\n\t,CAST(d.RecordDate as date) RecordDate\r\n\t,d.disc\r\n\t,h.freight\r\n\t,cast(h.CreateDate as date) InvCreateDate\r\n\t,cast(d.CreateDate as date) LineCreateDate\r\n\t,d.DLDeleteIndicator\r\nFrom invhdr h\r\nLeft Join invdtl d on h.inv_num = d.inv_num and h.site_ref = d.site_ref\r\n--Left join CustomerOrder co on h.co_num = co.co_num and d.co_line = co.co_line and h.site_ref = co.site_ref\r\n--where h.rn = 1  and  h.co_num != ''"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
