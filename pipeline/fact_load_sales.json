							"type": "NonQuery",
							"text": "\r\nupdate tgt\r\n\tset tgt.Amount = (tgt.Price * tgt.Quantity) * (1 - (Discount/100))\r\nfrom\r\n\ttemp_SRO_Sales tgt\r\n\r\n"
						}
